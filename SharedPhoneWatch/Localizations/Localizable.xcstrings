    "This sensor is already active. Use Take over or Parallel instead of fresh activation." : {
      "comment" : "Error message when trying to activate a fresh sensor when the sensor is already active.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Sensor ist bereits aktiv. Verwende statt der Erstaktivierung den Modus „Übernehmen“ oder „Parallel“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este sensor ya está activo. Usa Tomar el control o Paralelo en lugar de la activación inicial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce capteur est déjà actif. Utilisez Reprendre ou Parallèle au lieu de la première activation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo sensore è già attivo. Usa Acquisisci o Parallela invece della prima attivazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセンサーはすでに有効です。新品の有効化ではなく「引き継ぐ」または「並列」を使用してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze sensor is al actief. Gebruik Overnemen of Parallel in plaats van de eerste activering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten sensor jest już aktywny. Zamiast pierwszej aktywacji użyj opcji Przejmij lub Równoległy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот датчик уже активен. Вместо первичной активации используйте режим «Перехватить» или «Параллельный»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此传感器已激活。请使用“接管”或“并行”，而不是首次激活。"
          }
        }
      }
    },
    "This sensor isn't active yet. Start it in the FreeStyle Libre 3 app first, then pair it here." : {
      "comment" : "Friendly message when pairing a sensor that isn't active yet.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Sensor ist noch nicht aktiv. Starte ihn zuerst in der FreeStyle Libre 3-App und kopple ihn anschließend hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este sensor aún no está activo. Inícialo primero en la app FreeStyle Libre 3 y después enlázalo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce capteur n’est pas encore actif. Démarrez-le d’abord dans l’app FreeStyle Libre 3, puis associez-le ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
