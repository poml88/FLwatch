      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Widget zeigt den vollständigen Glukoseverlauf und den aktuellen Blutzuckerwert an."
