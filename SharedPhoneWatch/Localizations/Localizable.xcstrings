    "Activity has not been updated for %lld mins. Tap to refresh" : {
      "comment" : "A message displayed on the lock screen when the glucose activity data is stale. The argument is the number of minutes after which the data is considered stale.",
      "isCommentAutoGenerated" : true
    },
