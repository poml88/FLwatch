    "Not enough recent sensor history to assess whether glucose has settled." : {
      "comment" : "A warning that there is not enough recent sensor history to assess whether glucose has settled.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es liegen nicht genügend aktuelle Sensordaten vor, um zu beurteilen, ob sich der Glukosewert stabilisiert hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay suficiente historial reciente del sensor para determinar si la glucosa se ha estabilizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique récent du capteur est insuffisant pour déterminer si la glycémie s’est stabilisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati recenti del sensore non sono sufficienti per valutare se la glicemia si è stabilizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グルコース値が安定したかどうかを判断するための最近のセンサー履歴が不足しています。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn onvoldoende recente sensorgegevens om te beoordelen of de glucosewaarde is gestabiliseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak wystarczających ostatnich danych z sensora, aby ocenić, czy poziom glukozy się ustabilizował."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостаточно недавних данных датчика, чтобы оценить, стабилизировался ли уровень глюкозы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近期传感器历史数据不足，无法判断血糖是否已趋于稳定。"
          }
        }
      }
    },
