    "Pairing is complete. Keep your phone near the sensor — readings arrive about once a minute over Bluetooth." : {
      "comment" : "A footer for the paired section of the connect screen.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopplung ist abgeschlossen. Halte dein Smartphone in der Nähe des Sensors – Messwerte kommen etwa einmal pro Minute über Bluetooth an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace ha finalizado. Mantén el teléfono cerca del sensor; las lecturas llegan aproximadamente una vez por minuto mediante Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
