          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No he recibido las credenciales (aún) desde el teléfono. Prueba a pulsar \"Conectar\" en el teléfono para volver a enviarlas al reloj y espera un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune information d'identification n'a (encore) été reçue du téléphone. Essayez d'appuyer sur « Se connecter » sur le téléphone pour renvoyer l'information, puis attendez une minute.\n"
          }
