    "Account temporarily locked. Too many failed login attempts. Try again in 5 minutes. Check credentials." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto vorübergehend gesperrt. Zu viele fehlgeschlagene Anmeldeversuche. Versuchen Sie es in 5 Minuten erneut. Überprüfen Sie Ihre Anmeldedaten."
          }
        },
        "es" : {
          "stringUnit" : {
