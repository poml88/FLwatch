    "Glucose is moving. Wait for a steady stretch before comparing." : {
      "comment" : "A warning that glucose is moving.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Glukosewert verändert sich. Warte vor dem Vergleich auf einen stabilen Verlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La glucosa está cambiando. Espera a que se mantenga estable antes de comparar."
