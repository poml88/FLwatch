    "Reads the sensor's details over NFC without pairing or changing anything — safe to use while the Libre 3 app is running." : {
      "comment" : "A description of the action of reading a sensor's details.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest die Sensordetails per NFC aus, ohne etwas zu koppeln oder zu ändern – dies ist auch bei laufender Libre 3-App sicher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee los detalles del sensor por NFC sin enlazarlo ni cambiar nada; se puede usar de forma segura mientras la app Libre 3 está abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit les informations du capteur par NFC sans l’associer ni rien modifier ; vous pouvez l’utiliser sans risque pendant que l’app Libre 3 fonctionne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge i dettagli del sensore tramite NFC senza abbinarlo né modificare nulla: è sicuro usarlo mentre l’app Libre 3 è in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングや変更をせずにNFCでセンサーの詳細を読み取ります。Libre 3アプリの実行中でも安全に使用できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leest via NFC de sensorgegevens zonder te koppelen of iets te wijzigen; veilig te gebruiken terwijl de Libre 3-app actief is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytuje szczegóły sensora przez NFC bez parowania ani wprowadzania zmian — tej funkcji można bezpiecznie używać podczas działania aplikacji Libre 3."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Читает сведения о датчике через NFC без сопряжения и внесения изменений — можно безопасно использовать во время работы приложения Libre 3."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过NFC读取传感器详细信息，不进行配对或任何更改；Libre 3 App运行时也可安全使用。"
          }
        }
      }
    },
