    "Sensor readings are flat now, but glucose changed substantially during the past hour. Wait longer before comparing." : {
      "comment" : "A warning that sensor readings are not stable.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sensorwerte sind momentan stabil, aber der Glukosewert hat sich in der vergangenen Stunde deutlich verändert. Warte vor dem Vergleich noch länger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las lecturas del sensor están estables ahora, pero la glucosa cambió considerablemente durante la última hora. Espera más antes de comparar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mesures du capteur sont stables actuellement, mais la glycémie a sensiblement évolué au cours de la dernière heure. Attendez encore avant d’effectuer une comparaison."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le letture del sensore sono stabili ora, ma la glicemia è cambiata notevolmente nell'ultima ora. Attendi ancora prima di effettuare il confronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のセンサー値は安定していますが、過去1時間にグルコース値が大きく変動しました。比較する前に、もうしばらく待ってください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sensorwaarden zijn nu stabiel, maar de glucosewaarde is het afgelopen uur aanzienlijk veranderd. Wacht langer voordat je vergelijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczyty sensora są teraz stabilne, ale w ciągu ostatniej godziny poziom glukozy znacznie się zmienił. Poczekaj dłużej przed porównaniem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас показания датчика стабильны, но за последний час уровень глюкозы значительно изменился. Подождите ещё перед сравнением."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "传感器读数目前较为平稳，但血糖在过去一小时内发生了明显变化。请再等待一段时间后进行比较。"
          }
        }
      }
    },
