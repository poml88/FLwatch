    "Account temporarily locked. Too many failed login attempts. Try again in 5 minutes. Check credentials." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto vorübergehend gesperrt. Zu viele fehlgeschlagene Anmeldeversuche. Versuchen Sie es in 5 Minuten erneut. Überprüfen Sie Ihre Anmeldedaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account temporarily locked. Too many failed login attempts. Try again in 5 minutes. Check credentials."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte temporairement verrouillé. Trop de tentatives de connexion infructueuses. Réessayez dans 5 minutes. Vérifiez vos identifiants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account temporaneamente bloccato. Troppi tentativi di accesso non riusciti. Riprova tra 5 minuti. Controlla le credenziali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントが一時的にロックされました。ログイン試行が複数回失敗しました。5分後に再試行してください。認証情報を確認してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account tijdelijk vergrendeld. Te veel mislukte inlogpogingen. Probeer het over 5 minuten opnieuw. Controleer de inloggegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto zostało tymczasowo zablokowane. Zbyt wiele nieudanych prób logowania. Spróbuj ponownie za 5 minut. Sprawdź dane logowania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учетная запись временно заблокирована. Слишком много неудачных попыток входа. Попробуйте снова через 5 минут. Проверьте учетные данные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账户暂时被锁定。登录尝试次数过多。请在5分钟后再试。请检查登录凭据。"
          }
        }
      }
    },
