          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte temporairement verrouillé. Trop de tentatives de connexion infructueuses. Réessayez dans 5 minutes. Vérifiez vos identifiants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account temporaneamente bloccato. Troppi tentativi di accesso non riusciti. Riprova tra 5 minuti. Controlla le credenziali."
          }
        },
        "ja" : {
          "stringUnit" : {
