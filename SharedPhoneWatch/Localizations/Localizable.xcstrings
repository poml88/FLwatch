    "Ask the system to record insulin units for IOB calculation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehl um Insulineinheiten für die IOB Berechnung zu protokollieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pida al sistema que registre las unidades de insulina para el cálculo de la IOB."
          }
