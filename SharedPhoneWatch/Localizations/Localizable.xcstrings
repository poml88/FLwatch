    "No credentials (yet) received from phone. Try tapping 'Connect' on phone to resend to watch and wait a minute." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Noch) keine Zugangsdaten vom iPhone erhalten. Drücken Sie \"Verbinden\" auf dem iPhone und warten Sie 1 Minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No he recibido las credenciales (aún) desde el teléfono. Prueba a pulsar \"Conectar\" en el teléfono para volver a enviarlas al reloj y espera un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune information d'identification n'a (encore) été reçue du téléphone. Essayez d'appuyer sur « Se connecter » sur le téléphone pour renvoyer l'information, puis attendez une minute.\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sono state (ancora) ricevute credenziali dal telefono. Prova a toccare \"Connetti\" sul telefono per inviarle nuovamente all'orologio e attendi un minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電話から資格情報がまだ受信されていません。電話で「接続」をタップしてウォッチに再送信し、1分間お待ちください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen inloggegevens van de telefoon ontvangen. Probeer op de telefoon op 'Connect' te tikken om ze opnieuw naar het horloge te sturen en wacht een minuut."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie odebrano jeszcze danych logowania z telefonu. Spróbuj stuknąć „Connect” na telefonie, aby wysłać je ponownie do zegarka, i odczekaj minutę."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учетные данные еще не получены с телефона. Попробуйте нажать 'Connect' на телефоне, чтобы повторно отправить их на часы, и подождите минуту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未从手机收到凭据。请在手机上点击“连接”重新发送至手表并等待一分钟。"
          }
        }
      }
    },
