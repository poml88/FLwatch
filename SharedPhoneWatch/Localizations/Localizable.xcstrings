    "A Libre 3 BLE reading is needed before the current raw sensor value can be shown." : {
      "comment" : "A message displayed when a Libre 3 BLE reading is not available.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor der aktuelle Sensorrohwert angezeigt werden kann, ist ein Libre 3 BLE-Messwert erforderlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita una lectura de Libre 3 BLE para poder mostrar el valor bruto actual del sensor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une mesure Libre 3 BLE est nécessaire avant de pouvoir afficher la valeur brute actuelle du capteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È necessaria una lettura Libre 3 BLE prima di poter mostrare il valore grezzo attuale del sensore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のセンサー未補正値を表示するには、Libre 3 BLEの測定値が必要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een Libre 3 BLE-meting nodig voordat de huidige onbewerkte sensorwaarde kan worden weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby można było wyświetlić bieżącą surową wartość z sensora, wymagany jest odczyt Libre 3 BLE."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для отображения текущего исходного значения датчика необходимо показание Libre 3 BLE."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
