require "fileutils"
require "dotenv"
require "json"
require "tempfile"

opt_out_usage

default_platform(:ios)

Dotenv.load(
  File.expand_path("../.env.fastlane.local", __dir__),
  File.expand_path("../.env", __dir__)
)

legacy_key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s
legacy_issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s
legacy_key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s

ENV["FASTLANE_APP_STORE_CONNECT_API_KEY_ID"] = legacy_key_id if ENV["FASTLANE_APP_STORE_CONNECT_API_KEY_ID"].to_s.empty? && !legacy_key_id.empty?
ENV["FASTLANE_APP_STORE_CONNECT_API_KEY_ISSUER_ID"] = legacy_issuer_id if ENV["FASTLANE_APP_STORE_CONNECT_API_KEY_ISSUER_ID"].to_s.empty? && !legacy_issuer_id.empty?
ENV["FASTLANE_APP_STORE_CONNECT_API_KEY_PATH"] = legacy_key_path if ENV["FASTLANE_APP_STORE_CONNECT_API_KEY_PATH"].to_s.empty? && !legacy_key_path.empty?

# Prevent pilot/deliver from auto-reading legacy env vars as their own conflicting auth options.
ENV.delete("APP_STORE_CONNECT_API_KEY")
ENV.delete("APP_STORE_CONNECT_API_KEY_PATH")
ENV.delete("DELIVER_API_KEY")
ENV.delete("DELIVER_API_KEY_PATH")
ENV.delete("PILOT_API_KEY")
ENV.delete("PILOT_API_KEY_PATH")

SUPPORTED_RELEASE_LOCALES = %w[
  de-DE
  en-GB
  es-ES
  fr-FR
  it
  ja
  nl-NL
  pl
  ru
  zh-Hans
].freeze

SCHEME = ENV.fetch("FASTLANE_SCHEME", "FLwatch")
EXPORT_METHOD = ENV.fetch("FASTLANE_EXPORT_METHOD", "app-store")
WHATS_NEW_FILE = File.expand_path("whats_new/en-GB.txt", __dir__)
WHAT_TO_TEST_FILE = File.expand_path("what_to_test/en-GB.txt", __dir__)
METADATA_PATH = File.expand_path("metadata", __dir__)
APP_DESCRIPTION_METADATA_PATH = File.expand_path("app_descriptions", __dir__)

def ensure_full_xcode_selected!
  developer_dir = Actions.sh("xcode-select -p", log: false).strip
  return unless developer_dir == "/Library/Developer/CommandLineTools"

  UI.user_error!(
    "xcodebuild is pointing at Command Line Tools. Run " \
    "`sudo xcode-select -s /Applications/Xcode.app/Contents/Developer` first."
  )
end

def app_store_connect_api_key_if_configured
  key_id = ENV["FASTLANE_APP_STORE_CONNECT_API_KEY_ID"].to_s
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s if key_id.empty?

  issuer_id = ENV["FASTLANE_APP_STORE_CONNECT_ISSUER_ID"].to_s
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s if issuer_id.empty?

  key_filepath = ENV["FASTLANE_APP_STORE_CONNECT_API_KEY_PATH"].to_s
  key_filepath = ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s if key_filepath.empty?

  return nil if key_id.empty? || issuer_id.empty? || key_filepath.empty?

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_filepath
  )
end

def app_store_connect_key_values
  key_id = ENV["FASTLANE_APP_STORE_CONNECT_API_KEY_ID"].to_s
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s if key_id.empty?

  issuer_id = ENV["FASTLANE_APP_STORE_CONNECT_API_KEY_ISSUER_ID"].to_s
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s if issuer_id.empty?

  key_filepath = ENV["FASTLANE_APP_STORE_CONNECT_API_KEY_PATH"].to_s
  key_filepath = ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s if key_filepath.empty?

  return nil if key_id.empty? || issuer_id.empty? || key_filepath.empty?

  {
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_filepath
  }
end

def with_deliver_api_key_json
  key_values = app_store_connect_key_values
  UI.user_error!("Missing App Store Connect API key configuration for release lane") if key_values.nil?

  json_file = Tempfile.new(["app_store_connect_api_key", ".json"])
  json_file.write(
    JSON.generate(
      key_id: key_values[:key_id],
      issuer_id: key_values[:issuer_id],
      key: File.binread(File.expand_path(key_values[:key_filepath]))
    )
  )
  json_file.flush

  yield json_file.path
ensure
  json_file.close! if json_file
end

def with_cleared_auth_env
  keys = %w[
    APP_STORE_CONNECT_API_KEY
    APP_STORE_CONNECT_API_KEY_PATH
    PILOT_API_KEY
    PILOT_API_KEY_PATH
    DELIVER_API_KEY
    DELIVER_API_KEY_PATH
  ]

  previous_values = {}
  keys.each do |key|
    previous_values[key] = ENV.key?(key) ? ENV[key] : :__missing__
    ENV.delete(key)
  end

  yield
ensure
  previous_values.each do |key, value|
    if value == :__missing__
      ENV.delete(key)
    else
      ENV[key] = value
    end
  end
end

def whats_new_text
  UI.user_error!("Missing release notes file at #{WHATS_NEW_FILE}") unless File.exist?(WHATS_NEW_FILE)

  text = File.read(WHATS_NEW_FILE).strip
  UI.user_error!("Release notes file is empty: #{WHATS_NEW_FILE}") if text.empty?

  text
end

def what_to_test_text
  UI.user_error!("Missing external testing notes file at #{WHAT_TO_TEST_FILE}") unless File.exist?(WHAT_TO_TEST_FILE)

  text = File.read(WHAT_TO_TEST_FILE).strip
  UI.user_error!("External testing notes file is empty: #{WHAT_TO_TEST_FILE}") if text.empty?

  text
end

def prepare_release_notes!
  text = whats_new_text

  # Prevent stale metadata from re-activating locales you don't use in App Store Connect.
  FileUtils.rm_rf(File.join(METADATA_PATH, "en-US"))

  SUPPORTED_RELEASE_LOCALES.each do |locale|
    locale_dir = File.join(METADATA_PATH, locale)
    FileUtils.mkdir_p(locale_dir)
    File.write(File.join(locale_dir, "release_notes.txt"), "#{text}\n")
  end
end

def validate_app_descriptions!
  missing_locales = []
  empty_locales = []

  SUPPORTED_RELEASE_LOCALES.each do |locale|
    description_path = File.join(APP_DESCRIPTION_METADATA_PATH, locale, "description.txt")

    if !File.exist?(description_path)
      missing_locales << locale
    elsif File.read(description_path).strip.empty?
      empty_locales << locale
    end
  end

  unexpected_locales = if Dir.exist?(APP_DESCRIPTION_METADATA_PATH)
                         Dir.children(APP_DESCRIPTION_METADATA_PATH).select do |entry|
                           File.directory?(File.join(APP_DESCRIPTION_METADATA_PATH, entry)) &&
                             !SUPPORTED_RELEASE_LOCALES.include?(entry)
                         end
                       else
                         []
                       end

  errors = []
  errors << "Missing description.txt for: #{missing_locales.join(', ')}" unless missing_locales.empty?
  errors << "Empty description.txt for: #{empty_locales.join(', ')}" unless empty_locales.empty?
  errors << "Unexpected locale directories: #{unexpected_locales.sort.join(', ')}" unless unexpected_locales.empty?

  UI.user_error!(errors.join("\n")) unless errors.empty?
end

def external_groups
  groups = ENV.fetch("TESTFLIGHT_EXTERNAL_GROUPS", "External")
              .split(",")
              .map(&:strip)
              .reject(&:empty?)

  UI.user_error!("Set TESTFLIGHT_EXTERNAL_GROUPS before running external distribution") if groups.empty?

  groups
end

def editable_app_store_version_string(app_identifier:, platform: "ios")
  app = Spaceship::ConnectAPI::App.find(app_identifier)
  UI.user_error!("Couldn't find app with identifier #{app_identifier}") if app.nil?

  version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform.map(platform))
  UI.user_error!("Couldn't find an editable App Store version for #{app_identifier}") if version.nil?

  version.version_string
end

platform :ios do
  private_lane :build_archive do
    ensure_full_xcode_selected!

    build_app(
      scheme: SCHEME,
      clean: true,
      export_method: EXPORT_METHOD,
      export_options: {
        manageAppVersionAndBuildNumber: false
      }
    )
  end

  desc "Build and upload a build for internal TestFlight testers"
  lane :testflight_internal do
    build_archive

    with_deliver_api_key_json do |api_key_json_path|
      with_cleared_auth_env do
        upload_to_testflight(
          api_key_path: api_key_json_path,
          changelog: what_to_test_text,
          distribute_external: false,
          skip_waiting_for_build_processing: true
        )
      end
    end
  end

  desc "Build and upload a build for external TestFlight testers"
  lane :testflight_external do
    build_archive

    with_deliver_api_key_json do |api_key_json_path|
      with_cleared_auth_env do
        upload_to_testflight(
          api_key_path: api_key_json_path,
          changelog: what_to_test_text,
          distribute_external: true,
          groups: external_groups,
          notify_external_testers: true,
          skip_waiting_for_build_processing: false
        )
      end
    end
  end

  desc "Upload the English What's New text to all localizations on the editable App Store version"
  lane :upload_whats_new do
    with_deliver_api_key_json do |api_key_json_path|
      # Authorize the direct Connect API lookup used to require an existing editable version.
      app_store_connect_api_key_if_configured

      app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
      app_version = editable_app_store_version_string(
        app_identifier: app_identifier,
        platform: "ios"
      )

      with_cleared_auth_env do
        set_changelog(
          api_key_path: api_key_json_path,
          version: app_version,
          changelog: whats_new_text
        )
      end
    end
  end

  desc "Upload localized app descriptions to the existing editable App Store version"
  lane :upload_descriptions do
    validate_app_descriptions!

    with_deliver_api_key_json do |api_key_json_path|
      # Authorize the direct Connect API lookup used to require an existing editable version.
      app_store_connect_api_key_if_configured

      app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
      app_version = editable_app_store_version_string(
        app_identifier: app_identifier,
        platform: "ios"
      )

      UI.message("Uploading localized descriptions to App Store version #{app_version}")

      with_cleared_auth_env do
        upload_to_app_store(
          api_key_path: api_key_json_path,
          app_version: app_version,
          metadata_path: APP_DESCRIPTION_METADATA_PATH,
          skip_binary_upload: true,
          skip_screenshots: true,
          skip_app_version_update: true,
          force: true,
          run_precheck_before_submit: false,
          submit_for_review: false
        )
      end
    end
  end

  desc "Build and upload an App Store release, copying English release notes to all locales"
  lane :release do
    build_archive
    prepare_release_notes!

    with_deliver_api_key_json do |api_key_json_path|
      with_cleared_auth_env do
        upload_to_app_store(
          api_key_path: api_key_json_path,
          metadata_path: METADATA_PATH,
          force: true,
          precheck_include_in_app_purchases: false,
          skip_screenshots: true,
          submit_for_review: ENV["SUBMIT_FOR_REVIEW"] == "1",
          automatic_release: ENV["AUTO_RELEASE"] == "1"
        )
      end
    end
  end

  desc "Submit an already uploaded TestFlight build for App Store release"
  lane :release_existing_build do
    options = {
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: ENV["SUBMIT_FOR_REVIEW"] == "1",
      automatic_release: ENV["AUTO_RELEASE"] == "1"
    }

    build_number = ENV["APP_STORE_BUILD_NUMBER"].to_s.strip
    options[:build_number] = build_number unless build_number.empty?

    with_deliver_api_key_json do |api_key_json_path|
      with_cleared_auth_env do
        set_changelog(
          api_key_path: api_key_json_path,
          changelog: whats_new_text
        )

        # `deliver` auto-detects `app_version` from the newest local `*.ipa` if present.
        # For existing-build submissions that can point at a stale archive, so pin the
        # editable App Store Connect version we just updated instead.
        options[:app_version] = editable_app_store_version_string(
          app_identifier: CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier),
          platform: "ios"
        )

        upload_to_app_store(api_key_path: api_key_json_path, **options)
      end
    end
  end
end
